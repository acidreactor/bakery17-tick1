# скопировать в .env и поменять пароли
NGINX_PORT=8080

MYSQL_ROOT_PASSWORD=rootpass_change_me
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wppass_change_me

# юзер mysql для telegraf, создаётся при первом старте
MYSQL_MONITOR_USER=telegraf
MYSQL_MONITOR_PASSWORD=telegrafpass_change_me

# алерты в телегу (по желанию)
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
